{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/tools/mock-api-generator", "destination": "/index.html" },
    { "source": "/api/manage/:path*", "destination": "/api/manage/[...path]" },
    { "source": "/api/v1/:path*", "destination": "/api/v1/[...path]" }
  ],
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "17 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  }
}
