# ---------- Database (Neon Postgres) ----------
# Use the POOLED connection string (host contains "-pooler").
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------- OpenRouter (server-side only, never exposed to the browser) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_RETRIES=2

# ---------- Free-tier limits (all optional, defaults shown) ----------
MAX_PROJECTS_PER_OWNER=5
MAX_RESOURCES_PER_PROJECT=10
MAX_RECORDS_PER_RESOURCE=100
MAX_REQUESTS_PER_DAY=1000
MAX_DELAY_MS=5000
AI_DAILY_LIMIT=20

# ---------- Rate limiting / abuse protection ----------
RATE_LIMIT_IP_PER_MIN=120          # public /api/v1 requests per IP per minute
RATE_LIMIT_MANAGE_PER_MIN=90       # /api/manage requests per IP per minute
MAX_PROJECT_CREATES_PER_IP_PER_DAY=10
MAX_BODY_BYTES=16384               # public API request body limit
MANAGE_MAX_BODY_BYTES=262144       # management API body limit (imports)

# ---------- Housekeeping ----------
INACTIVE_PROJECT_DAYS=30
CRON_SECRET=change-me-long-random  # Vercel sends it as "Authorization: Bearer <secret>" to cron routes
IP_HASH_SALT=change-me-too         # salt for hashing IPs in request_logs

# ---------- Web ----------
# Origins allowed to call /api/manage from another site (comma separated). Same-origin always works.
ALLOWED_ORIGINS=https://www.frugaltesting.com,https://frugaltesting.com
# Optional: force the public base URL shown in the UI (otherwise derived from the request host)
PUBLIC_BASE_URL=

# ---------- Local development only ----------
# LOCAL_DB=pglite   # runs an embedded Postgres (no Neon needed): npm run dev:local
